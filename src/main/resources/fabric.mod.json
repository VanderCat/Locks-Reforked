{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "Locks Rewritten",
	"description": "Universal locks dynamically attached to Block Entities with a lock picking mechanic",
	"authors": [
      "VanderCat"
	],
	"contributors": [
      "Melonslise", "Kaleb Langley", "Yuqi154", "Parakoh"
    ],
	"icon": "icon.png",
	"accessWidener" : "locks.accesswidener",
	"contact": {
      "homepage": "https://modrinth.com/mod/locks-rewritten",
      "sources": "https://github.com/VanderCat/Locks-Rewritten",
      "issues": "https://github.com/VanderCat/Locks-Rewritten/issues"
	},
	"license": "CC-BY-NC-3.0",
	"environment": "*",
	"entrypoints": {
		"fabric-datagen": [
			"melonslise.locks.datagen.LocksDatagen"
		],
		"main": [
			"melonslise.locks.Locks"
		],
		"client": [
			"melonslise.locks.Locks"
		],
		"cardinal-components": ["melonslise.locks.init.LocksComponents"],
		"jei_mod_plugin": ["melonslise.locks.compat.jei.LocksJeiPlugin"],
		"rei_client": ["melonslise.locks.compat.rei.LocksReiPlugin"]
	},
	"mixins": [
        "locks.mixins.json",
		"locks.mixins.compat.json"
	],
	"depends": {
		"fabricloader": ">=0.14.21",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*",
		"cardinal-components-base": ">=5.2.2",
		"cardinal-components-item": ">=5.2.2",
		"cardinal-components-entity": ">=5.2.2",
		"cardinal-components-world": ">=5.2.2",
		"cardinal-components-chunk": ">=5.2.2"
	},
	"suggests": {
		"jei": ">=15.17.0.0",
		"rei": ">=12.0.613"
	},
	"custom": {
		"cardinal-components": [
			"locks:locked"
		]
	}
}